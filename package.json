{
  "name": "vn-free-docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "VN Free Docs — tài liệu, mẫu Excel và công cụ miễn phí cho người Việt, cùng giải pháp công nghệ cho doanh nghiệp.",
  "workspaces": [
    "server"
  ],
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "format": "prettier --write .",
    "api": "npm run start -w vn-free-docs-api",
    "api:dev": "npm run dev -w vn-free-docs-api",
    "api:memory": "npm run dev:memory -w vn-free-docs-api",
    "api:test": "npm run test -w vn-free-docs-api"
  },
  "config": {
    "mongodbMemoryServer": {
      "disablePostinstall": "1"
    }
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.1.0",
    "@mdi/font": "^7.4.47",
    "vue": "^3.5.13",
    "vuetify": "^3.7.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "vite": "^5.4.11",
    "vite-plugin-vuetify": "^2.0.4"
  }
}
